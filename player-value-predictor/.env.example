# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
TM_DB=/mnt/data/datasets/transfermarkt/transfermarkt-datasets.duckdb

# Optional: absolute path to a trusted frozen model bundle (default: artifacts/phase2b)
# PVP_ARTIFACT_DIR=/mnt/data/workspace/player-value-predictor/artifacts/phase2b

# Phase 4: the app reads environment variables; .env is not loaded automatically.
# Set false to force local fallback explanations even if a key is present.
PVP_LLM_ENABLED=true
PVP_LLM_DAILY_CAP=100
# Must be writable and persistent to preserve the cap across restarts.
# PVP_LLM_USAGE_DB=/mnt/data/workspace/player-value-predictor/data/llm_usage.sqlite3
PVP_RATE_LIMIT_PER_MINUTE=60

# Phase 5 server entry point: python src/server.py
PORT=8000
# Render Free uses PVP_LLM_ENABLED=false because its local usage store is ephemeral.
